{
	"name": "np",
	"version": "12.1.1",
	"description": "A better `npm publish`",
	"license": "MIT",
	"repository": "sindresorhus/np",
	"funding": "https://github.com/sindresorhus/np?sponsor=1",
	"type": "module",
	"bin": "./source/cli.js",
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26",
		"npm": ">=10",
		"git": ">=2.11.0",
		"yarn": ">=1.7.0",
		"pnpm": ">=11",
		"bun": ">=1"
	},
	"scripts": {
		"test": "FORCE_HYPERLINK=1 HOME=/tmp NODE_ENV=test GIT_AUTHOR_NAME=test GIT_COMMITTER_NAME=test GIT_AUTHOR_EMAIL=test@example.com GIT_COMMITTER_EMAIL=test@example.com sh -c 'xo && node --test \"test/{*.js,!(_helpers|fixtures)/**/*.js}\"'"
	},
	"files": [
		"source"
	],
	"keywords": [
		"cli-app",
		"cli",
		"npm",
		"publish",
		"git",
		"push",
		"version",
		"bump",
		"commit"
	],
	"dependencies": {
		"@inquirer/core": "^12.0.4",
		"chalk": "^6.0.1",
		"chalk-template": "^1.1.3",
		"cli-truncate": "^6.1.1",
		"clipboardy": "^5.3.2",
		"cosmiconfig": "^10.0.1",
		"del": "^8.0.1",
		"escape-goat": "^4.0.0",
		"execa": "^10.0.1",
		"exit-hook": "^5.1.0",
		"github-url-from-git": "^1.5.0",
		"hosted-git-info": "^10.1.1",
		"ignore-walk": "^9.0.0",
		"import-local": "^3.2.0",
		"inquirer": "^14.2.2",
		"is-installed-globally": "^1.0.1",
		"is-interactive": "^2.0.0",
		"is-scoped": "^3.0.0",
		"issue-regex": "^4.3.0",
		"log-symbols": "^7.0.1",
		"log-update": "^8.0.0",
		"meow": "^14.1.0",
		"new-github-release-url": "^2.0.0",
		"npm-name": "^8.1.1",
		"onetime": "^8.0.0",
		"open": "^11.0.4",
		"p-memoize": "^8.0.0",
		"package-directory": "^8.2.0",
		"path-exists": "^5.0.0",
		"read-package-up": "^12.0.0",
		"read-pkg": "^10.1.0",
		"semver": "^7.8.5",
		"strip-ansi": "^7.2.0",
		"terminal-link": "^5.0.0",
		"update-notifier": "^7.3.1"
	},
	"devDependencies": {
		"@sindresorhus/is": "^8.1.0",
		"@types/semver": "^7.8.0",
		"common-tags": "^1.8.2",
		"esmock": "^2.7.6",
		"fs-extra": "^11.4.1",
		"map-obj": "^6.0.0",
		"sinon": "^22.1.0",
		"tempy": "^3.2.0",
		"write-package": "^7.2.0",
		"xo": "^5.0.1"
	},
	"xo": [
		{
			"ignores": [
				".ai-temporary",
				"test/fixtures"
			]
		},
		{
			"rules": {
				"unicorn/no-immediate-mutation": "off",
				"unicorn/prefer-combined-guards": "off",
				"unicorn/prefer-early-return": "off",
				"unicorn/prefer-minimal-ternary": "off",
				"unicorn/prefer-simple-condition-first": "off",
				"unicorn/prefer-split-limit": "off",
				"unicorn/prefer-ternary": "off",
				"unicorn/single-line-block-comment-style": "off"
			}
		},
		{
			"files": [
				"test/**"
			],
			"rules": {
				"node-test/no-export": "off",
				"node-test/no-import-test-files": "off",
				"node-test/no-unknown-test-options": "off",
				"node-test/prefer-test-context-assert": "off",
				"node-test/require-assertion": "off",
				"node-test/require-throws-expectation": "off",
				"node-test/no-useless-assertion": "off",
				"unicorn/prefer-https": "off"
			}
		}
	]
}
